# PostgreSQL
POSTGRES_USER=clicars
POSTGRES_PASSWORD=clicars_pass
POSTGRES_DB=clicars_search

# Google Maps Scraper — nenhuma API key necessária.
# GOOGLEMAPS_BROWSER_POOL  -> instâncias de browser Chromium em paralelo
# GOOGLEMAPS_CONCURRENCY   -> goroutines de enrichment simultâneas
# GOOGLEMAPS_SCROLL_TIMEOUT -> timeout por scroll no painel de resultados
#
# Local (notebook/desktop): use valores baixos para não estourar a RAM.
GOOGLEMAPS_BROWSER_POOL=3
GOOGLEMAPS_CONCURRENCY=10
GOOGLEMAPS_SCROLL_TIMEOUT=30s
# Servidor dedicado: aumente conforme a capacidade (ex.: 30 / 300).

# URL da API chamada pelo navegador (baked-in no bundle Next.js em build time).
# Em produção, substitua pelo endereço público da sua API.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp — API hospedada Zennitex (obrigatório para painel WA + campanhas).
# Inclua o prefixo /api (nginx do painel). Sem essas vars, busca continua OK
# e as rotas /whatsapp + /campaigns ficam desabilitadas.
WHATSAPP_API_URL=https://whatsapp.zennitex.com.br/api
WHATSAPP_ADMIN_KEY=cole-aqui-a-API_SECRET_KEY-do-painel-whatsapp

# Campanhas WhatsApp — fila durável. O ritmo real é controlado pelo motor
# anti-ban (PROTECT_*), estes valores são fallback se o guard estiver off.
CAMPAIGN_MIN_DELAY=90s
CAMPAIGN_MAX_DELAY=4m
CAMPAIGN_RATE_PER_HOUR=20
CAMPAIGN_MAX_WORKERS=5

# Proteção anti-ban + aquecimento automático (America/Sao_Paulo).
# Teto operacional: 200 msgs/dia por número, espalhadas na janela comercial.
PROTECT_TIMEZONE=America/Sao_Paulo
PROTECT_START_HOUR=8
PROTECT_END_HOUR=20
PROTECT_LUNCH_PAUSE=on
PROTECT_DAILY_TARGET=200
PROTECT_MIN_DELAY=90s
PROTECT_MAX_DELAY=4m
PROTECT_REST_EVERY=10
PROTECT_REST_MIN=4m
PROTECT_REST_MAX=12m
WARMUP_INTERVAL=8m
WARMUP_TICK=3m
# Número principal: passa por TODAS as 4 fases (21 dias). Não pule a rampa.
WARMUP_PRIMARY_PHONES=554184376916
# Só use isto para chips que JÁ completaram 21 dias de aquecimento real.
WARMUP_MATURE_PHONES=
