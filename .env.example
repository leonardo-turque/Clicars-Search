# PostgreSQL
POSTGRES_USER=clicars
POSTGRES_PASSWORD=clicars_pass
POSTGRES_DB=clicars_search

# Google Maps Scraper — nenhuma API key necessária.
# GOOGLEMAPS_BROWSER_POOL  -> instâncias de browser Chromium em paralelo
# GOOGLEMAPS_CONCURRENCY   -> goroutines de enrichment simultâneas
# GOOGLEMAPS_SCROLL_TIMEOUT -> timeout por scroll no painel de resultados
#
# Local (notebook/desktop): use valores baixos para não estourar a RAM.
GOOGLEMAPS_BROWSER_POOL=3
GOOGLEMAPS_CONCURRENCY=10
GOOGLEMAPS_SCROLL_TIMEOUT=30s
# Servidor dedicado: aumente conforme a capacidade (ex.: 30 / 300).

# URL da API chamada pelo navegador (baked-in no bundle Next.js em build time).
# Em produção, substitua pelo endereço público da sua API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Campanhas WhatsApp — fila durável (anti-ban).
# CAMPAIGN_MIN_DELAY / CAMPAIGN_MAX_DELAY -> jitter entre mensagens
# CAMPAIGN_RATE_PER_HOUR                  -> teto por número WhatsApp
# CAMPAIGN_MAX_WORKERS                    -> sessões enviando em paralelo
CAMPAIGN_MIN_DELAY=30s
CAMPAIGN_MAX_DELAY=90s
CAMPAIGN_RATE_PER_HOUR=30
CAMPAIGN_MAX_WORKERS=5
